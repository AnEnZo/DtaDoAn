## AIOv2
CREATE_URL=/create
QUERY_URL=/query
REFUND_URL=/refund
CONFIRM_URL=/confirm
TOKEN_PAY_URL=/tokenization/pay
TOKEN_BIND_URL=/tokenization/bind
TOKEN_INQUIRY_URL=/tokenization/cbQuery
TOKEN_DELETE_URL=/tokenization/delete



# ============= PayPal Configuration =============
paypal.mode=sandbox

# Client Credentials
paypal.client-id=your_paypal_client_id
paypal.client-secret=your_paypal_client_secret

# API Configuration
paypal.api-base-url=https://api-m.sandbox.paypal.com
paypal.api-version=v2
paypal.currency=USD

# Webhook (for payment confirmation)
paypal.webhook-id=your_paypal_webhook_id
# webhook endpoint: your_ngrok_or_public_domain/api/invoices/paypal/webhook

# Return URLs
paypal.return-success-url=${PAYPAL_SUCCESS_URL:your_ngrok_or_public_domain/api/invoices/paypal/success}
paypal.return-cancel-url=${PAYPAL_CANCEL_URL:your_ngrok_or_public_domain/api/invoices/paypal/cancel}

# Connection Settings
paypal.connection-timeout=30000
paypal.read-timeout=30000

# Logging
paypal.logging-enabled=true

# Exchange rate for VND to USD conversion
paypal.exchange-rate-vnd-to-usd=25000

# SearchAPI.io
searchapi.api-key=your_searchapi_key
searchapi.base-url=https://www.searchapi.io/api/v1/search
# Trending Settings
trending.geo=VN
trending.time-window=past_24_hours
trending.category=food_and_drink
trending.update-interval-hours=6


# Scrapeless
scrapeless.api-key=your_scrapeless_api_key
scrapeless.base-url=https://api.scrapeless.com/api/v1/scraper/request

# SerpAPI
serpapi.api-key=your_serpapi_key
serpapi.base-url=https://serpapi.com/search.json

# Facebook
facebook.app-id=your_facebook_app_id
facebook.app-secret=your_facebook_app_secret
facebook.access-token=your_facebook_access_token

youtube.api-key=your_youtube_api_key


# Instagram Basic Display hoặc Graph API
# instagram.app-id=your_instagram_app_id
instagram.app-id=your_instagram_app_id
instagram.app-secret=your_instagram_app_secret
# instagram.access-token=your_instagram_access_token
instagram.business-account-id=your_instagram_business_account_id
#instagram.business-account-id=your_instagram_business_account_id
instagram.access-token=your_instagram_access_token

# Llama AI API Configuration
#llama.api.base-url=https://merna-archeological-snufflingly.ngrok-free.dev
llama.api.base-url=https://anenzo-llama-3-2-3b.hf.space

# Llama API Timeout Settings (in seconds)
# Connect timeout: time to establish connection
llama.api.connect-timeout=60
# Read timeout: time to wait for AI response (longer for AI processing + HF Space cold start)
llama.api.read-timeout=300

groq.api.key=your_groq_api_key
groq.api.model=llama-3.3-70b-versatile

cloudinary.cloud-name=your_cloudinary_cloud_name
cloudinary.api-key=your_cloudinary_api_key
cloudinary.api-secret=your_cloudinary_api_secret
