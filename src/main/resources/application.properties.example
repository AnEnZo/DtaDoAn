momo.ipn-url=your_ngrok_or_public_domain/api/invoices/webhook/momo
momo.redirect-url=your_ngrok_or_public_domain/api/invoices/return/momo
momo.currency=VND
momo.partner-code=your_momo_partner_code
momo.access-key=your_momo_access_key
momo.secret-key=your_momo_secret_key
momo.partner-name=${MOMO_PARTNER_NAME:Tiem Banh 247}
momo.request-type=${MOMO_REQUEST_TYPE:captureWallet}
momo.store-id=your_momo_store_id

